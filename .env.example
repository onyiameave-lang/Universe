# Copy to .env. Every key is OPTIONAL (honest degradation without them).

# ============================================================
# LLM Brain — Ollama (LOCAL, RECOMMENDED) or Cloud Providers
# ============================================================
# FIX-02: Ollama is now the PRIMARY LLM provider when configured.
# Ollama runs locally (no external API calls, no rate limits, no costs).
# Download models: ollama pull llama3
# Start Ollama: ollama serve (default port 11434)
# Examples: llama3, mistral, phi3, neural-chat, orca-mini
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# Cloud LLM providers (fallback if Ollama unavailable)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER_ORDER=ollama,anthropic,openai,gemini

# ============================================================
# Nexus Gemini-Powered Routing + RL Pipeline (FIX-CA-26)
# ============================================================
# NEXUS_GEMINI_KEY — SEPARATE key dedicated to Nexus routing decisions.
# Uses gemini-2.0-flash (fast, cheap). Different from GEMINI_API_KEY above.
# Plug in a second Gemini API key here. Get one at https://aistudio.google.com/
# When set: Nexus uses Gemini Flash to extract symbols, correct typos, and
# choose the right agent. Every decision is logged to Nexus/data/routing_decisions.jsonl
# and becomes training data for the local Ollama model (RL loop).
# When NOT set: Nexus falls back to COMPANY_ALIAS + regex extraction (always works).
NEXUS_GEMINI_KEY=

# GEMINI_API_KEY (above) is used for FINAL ANSWER SYNTHESIS (multi-agent merge).
# Ollama is tried first for synthesis; GEMINI_API_KEY is the fallback.

# RL training thresholds
NEXUS_MIN_SAMPLES=100          # Minimum logged decisions before local model is used
NEXUS_LOCAL_CONF=0.75          # Minimum local model confidence to trust it over Gemini
NEXUS_ACCURACY_THRESH=0.80     # Minimum eval accuracy to promote local model to Tier 1
NEXUS_TRAIN_MODEL=nexus-router # Name for the trained local routing model in Ollama

# --- Sentinel (news); RSS works without a key ---
NEWSAPI_KEY=

# --- Pulse (social); Reddit public JSON works without keys ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Chronicle embeddings ---
MEMORY_USE_REAL_EMBEDDINGS=false

# Authenticated loopback bridge for Oracle V1 to send feedback to Forge V2.
# Set this token in the V1 .env as well; do not commit a real token.
ORACLE_FORGE_BRIDGE_TOKEN=
# true starts only Chronicle, Atlas, and Forge in api.py (no second Oracle).
ORACLE_FORGE_BRIDGE_ONLY=false
# Local Oracle V1 API used to verify the active incumbent for no-trade screens.
ORACLE_V1_API_URL=http://127.0.0.1:8001
# Open a Chronicle + Atlas no-trade research case after this much active
# decision history without a fill; requires the minimum evaluations below.
FORGE_ORACLE_NO_TRADE_DAYS=14
FORGE_ORACLE_NO_TRADE_MIN_EVALUATIONS=10
FORGE_ORACLE_NO_TRADE_MAX_EVALUATION_GAP_HOURS=48
FORGE_ORACLE_NO_EVALUATION_MIN_CYCLES=12
FORGE_ORACLE_NO_EVALUATION_HOURS=24
# Concurrent Atlas/no-trade diagnostic jobs are bounded; queued jobs persist in Chronicle.
FORGE_ORACLE_DIAGNOSIS_MAX_WORKERS=2
# Mark a previously seen V1 trader heartbeat stale after this many seconds,
# extended to at least three times the trader's configured scan interval.
FORGE_ORACLE_HEARTBEAT_TIMEOUT_SEC=900
# Optional local path to the V1 .env containing cTrader credentials.
# Keep this path and the credentials in local .env files, not source control.
ORACLE_FORGE_CTRADER_ENV_FILE=

# Forge's read-only cTrader execution-cost evidence collection.
# Profiles stay blocked until measured broker evidence is complete.
ORACLE_FORGE_COST_WINDOW_HOURS=6
ORACLE_FORGE_DEAL_HISTORY_DAYS=1827
ORACLE_FORGE_MINIMUM_COST_DEALS=20
ORACLE_FORGE_MINIMUM_COST_QUOTES=100
ORACLE_FORGE_TICK_CHUNK_MINUTES=15
ORACLE_FORGE_QUOTE_MATCH_TOLERANCE_MS=1000

# --- Oracle / MT5 trading (SAFE DEFAULTS) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
ORACLE_PAPER_TRADING=true          # set false to trade live
ORACLE_ALLOW_LIVE=false            # extra lock for REAL-money accounts
# Telegram signal-only mode: approved setups are alerted; Oracle never places,
# modifies, or closes positions while this is true (default is true in code).
# Set false only if you intentionally want the existing automatic execution path.
ORACLE_SIGNAL_ONLY=true
ORACLE_TELEGRAM_BOT_TOKEN=
ORACLE_TELEGRAM_CHAT_ID=
ORACLE_TELEGRAM_DEDUPE_SEC=1800     # suppress repeat alerts for 30 minutes
ORACLE_SIGNAL_MATCH_TTL_SEC=21600   # match a manual position to a signal for 6 hours
# --- risk limits ---
RL_RISK_PER_TRADE=0.01
RL_MAX_POSITIONS=1
RL_MAX_DRAWDOWN_PCT=0.20
