# Chronicle Research Director — systemd timer
# The VPS reports UTC, and the operator specified the broker/server weekend
# closure as Friday 22:00 through Sunday 22:00. Run once at the start of that
# window; the one-shot director catches up all trades since its last successful
# report and reviews Oracle's recurring failure counts.
#
# See chronicle-research-director.service for install instructions.

[Unit]
Description=Run Chronicle Research Director at weekend market close

[Timer]
OnCalendar=Fri *-*-* 22:00:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
